<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" 
      prefHeight="500.0" prefWidth="400.0" spacing="20.0" styleClass="main-container" stylesheets="@../styles/style.css" style="-fx-background-color: #1E2532;">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    
    <Label text="Hai delle notifiche non lette" styleClass="title-label" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" />
    
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: #2D3748; -fx-border-radius: 5px;">
        <content>
             <VBox fx:id="notificationList" spacing="10.0" style="-fx-background-color: transparent;">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </VBox>
        </content>
    </ScrollPane>
    
    <HBox alignment="CENTER">
        <Button fx:id="continueBtn" mnemonicParsing="false" text="Continua" styleClass="action-button" prefWidth="150.0" />
    </HBox>
</VBox>

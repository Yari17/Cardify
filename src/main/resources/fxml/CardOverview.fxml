<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml" styleClass="card-overview" spacing="0" alignment="CENTER">
    
    <!-- Left Side: Card Image -->
    <VBox alignment="CENTER" styleClass="image-panel">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>
        <ImageView fx:id="cardImage" fitWidth="320" fitHeight="450" preserveRatio="true" styleClass="card-image"/>
    </VBox>
    
    <!-- Right Side: Details Panel -->
    <VBox styleClass="details-panel" HBox.hgrow="ALWAYS">
        <!-- Close Button -->
        <HBox alignment="TOP_RIGHT">
            <padding>
                <Insets top="10" right="10"/>
            </padding>
            <Button fx:id="closeBtn" text="✕" styleClass="close-button"/>
        </HBox>
        
        <!-- Scrollable Content -->
        <ScrollPane fx:id="detailsScroll" fitToWidth="true" styleClass="details-scroll" VBox.vgrow="ALWAYS">
            <VBox fx:id="detailsContent" spacing="20" styleClass="details-content">
                <padding>
                    <Insets top="10" right="30" bottom="30" left="30"/>
                </padding>
                
                <!-- Header: Name + HP + Type Icon -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label fx:id="cardNameLabel" styleClass="card-title"/>
                    <HBox fx:id="hpBox" alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="hpLabel" styleClass="hp-badge"/>
                        <HBox fx:id="typeContainer" alignment="CENTER_LEFT" spacing="2"/>
                    </HBox>
                </HBox>
                
                <!-- Stage -->
                <Label fx:id="stageLabel" styleClass="stage-label"/>
                
                <!-- Metadata Grid -->
                <VBox spacing="8" styleClass="metadata-section">
                    <HBox spacing="10">
                        <Label text="Set:" styleClass="meta-label"/>
                        <Label fx:id="setNameLabel" styleClass="meta-value"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Rarità:" styleClass="meta-label"/>
                        <Label fx:id="rarityLabel" styleClass="meta-value"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Illustratore:" styleClass="meta-label"/>
                        <Label fx:id="illustratorLabel" styleClass="meta-value"/>
                    </HBox>
                </VBox>
                
                <!-- Attacks Section (dynamically populated) -->
                <VBox fx:id="attacksContainer" spacing="12">
                    <Label text="Attacchi" styleClass="section-title"/>
                </VBox>
                
                <!-- Footer: Weakness, Retreat -->
                <HBox spacing="30" styleClass="footer-stats">
                    <VBox spacing="4">
                        <Label text="Debolezza" styleClass="meta-label"/>
                        <HBox fx:id="weaknessContainer" spacing="4" alignment="CENTER_LEFT"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="Ritirata" styleClass="meta-label"/>
                        <Label fx:id="retreatLabel" styleClass="meta-value"/>
                    </VBox>
                </HBox>
                
                <!-- Owner Info -->
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="owner-section">
                    <Label text="Collezionista:" styleClass="meta-label"/>
                    <Label fx:id="ownerLabel" styleClass="owner-name"/>
                </HBox>
            </VBox>
        </ScrollPane>
        
        <!-- Action Buttons -->
        <HBox alignment="CENTER" spacing="15">
            <padding>
                <Insets top="15" right="30" bottom="20" left="30"/>
            </padding>
            <Button fx:id="backBtn" text="← Indietro" styleClass="back-button"/>
            <Button fx:id="proposeTradeBtn" text="Proponi Scambio" styleClass="trade-button"/>
        </HBox>
    </VBox>
</HBox>

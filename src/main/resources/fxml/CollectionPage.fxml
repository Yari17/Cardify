<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="root"
      alignment="TOP_LEFT"
      spacing="0"
      prefHeight="600.0">

    <!-- Navbar (top) -->
    <HBox fx:id="navbar" alignment="CENTER_LEFT" spacing="12" prefHeight="80.0" styleClass="navbar">

        <!-- Left menu: HBox of transparent icon buttons -->
        <HBox fx:id="menuBox" spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="homeBtn" styleClass="nav-button">
                <graphic>
                    <VBox alignment="CENTER" spacing="4">
                        <ImageView fx:id="homeIcon" fitWidth="28" fitHeight="28" />
                        <Label text="Homepage" />
                    </VBox>
                </graphic>
            </Button>
            <Button fx:id="collectionBtn" styleClass="nav-button">
                <graphic>
                    <VBox alignment="CENTER" spacing="4">
                        <ImageView fx:id="collectionIcon" fitWidth="28" fitHeight="28" />
                        <Label text="Collection" />
                    </VBox>
                </graphic>
            </Button>
            <Button fx:id="tradeBtn" styleClass="nav-button">
                <graphic>
                    <VBox alignment="CENTER" spacing="4">
                        <ImageView fx:id="tradeIcon" fitWidth="28" fitHeight="28" />
                        <Label text="Trade" />
                    </VBox>
                </graphic>
            </Button>
            <Button fx:id="proposalBtn" styleClass="nav-button">
                <graphic>
                    <VBox alignment="CENTER" spacing="4">
                        <ImageView fx:id="proposalIcon" fitWidth="28" fitHeight="28" />
                        <Label text="Manage Proposals" />
                    </VBox>
                </graphic>
            </Button>
            <Button fx:id="logoutBtn" styleClass="nav-button">
                <graphic>
                    <VBox alignment="CENTER" spacing="4">
                        <ImageView fx:id="logoutIcon" fitWidth="28" fitHeight="28" />
                        <Label text="Logout" />
                    </VBox>
                </graphic>
            </Button>
        </HBox>

        <!-- Separator -->
        <Separator orientation="VERTICAL" styleClass="nav-separator" />

        <!-- spacer -->
        <Region HBox.hgrow="ALWAYS" />

        <!-- Right: Profile -->
        <VBox fx:id="profileBox" alignment="CENTER" spacing="6">
            <ImageView fx:id="avatarImage" fitWidth="48" fitHeight="48" preserveRatio="true" styleClass="profile-avatar" />
            <Label fx:id="usernameLabel" text="username" styleClass="profile-username" />
        </VBox>

    </HBox>

    <!-- Content area -->
    <VBox spacing="12" alignment="TOP_LEFT" style="-fx-padding: 18; -fx-background-color: #1E2532;" VBox.vgrow="ALWAYS">
        <!-- Header -->
        <VBox spacing="6">
            <Label text="MY COLLECTION" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 20px;" />
            <Region prefHeight="4" style="-fx-background-color: #2fb4f5; -fx-background-radius: 2;" />
        </VBox>

        <!-- Toolbar -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="createBinderBtn" text="Crea nuovo raccoglitore"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: #2fb4f5; -fx-border-radius: 6; -fx-padding: 8 12;" />
            
            <Region HBox.hgrow="ALWAYS" />
            
            <Button fx:id="saveBtn" text="Salva modifiche" visible="false" managed="false"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: bold; -fx-cursor: hand;" />
        </HBox>

        <!-- Scroll area and empty state stacked -->
        <StackPane VBox.vgrow="ALWAYS">
            <ScrollPane fx:id="scrollPane" fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox fx:id="binderContainer" spacing="25" style="-fx-padding: 20; -fx-background-color: transparent;" />
            </ScrollPane>

            <Label fx:id="emptyStateLabel" text="Non hai ancora nessun raccoglitore, creane uno nuovo"
                   style="-fx-text-fill: white; -fx-font-size: 14px;" visible="false" managed="false" />
        </StackPane>
    </VBox>

</VBox>

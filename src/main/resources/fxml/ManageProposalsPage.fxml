<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="root"
      alignment="TOP_LEFT"
      spacing="0"
      prefHeight="600.0">

    <!-- Navbar (top) -->
    <HBox fx:id="navbar" alignment="CENTER_LEFT" spacing="12" prefHeight="80.0" styleClass="navbar">

        <!-- Left menu: HBox of transparent icon buttons -->
        <HBox fx:id="menuBox" spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="homeBtn" styleClass="nav-button">
                <graphic>
                    <VBox alignment="CENTER" spacing="4">
                        <ImageView fx:id="homeIcon" fitWidth="28" fitHeight="28" />
                        <Label text="Homepage" />
                    </VBox>
                </graphic>
            </Button>
            <Button fx:id="collectionBtn" styleClass="nav-button">
                <graphic>
                    <VBox alignment="CENTER" spacing="4">
                        <ImageView fx:id="collectionIcon" fitWidth="28" fitHeight="28" />
                        <Label text="Collection" />
                    </VBox>
                </graphic>
            </Button>
            <Button fx:id="tradeBtn" styleClass="nav-button">
                <graphic>
                    <VBox alignment="CENTER" spacing="4">
                        <ImageView fx:id="tradeIcon" fitWidth="28" fitHeight="28" />
                        <Label text="Trade" />
                    </VBox>
                </graphic>
            </Button>
            <Button fx:id="proposalBtn" styleClass="nav-button">
                <graphic>
                    <VBox alignment="CENTER" spacing="4">
                        <ImageView fx:id="proposalIcon" fitWidth="28" fitHeight="28" />
                        <Label text="Manage Proposals" />
                    </VBox>
                </graphic>
            </Button>
            <Button fx:id="logoutBtn" styleClass="nav-button">
                <graphic>
                    <VBox alignment="CENTER" spacing="4">
                        <ImageView fx:id="logoutIcon" fitWidth="28" fitHeight="28" />
                        <Label text="Logout" />
                    </VBox>
                </graphic>
            </Button>
        </HBox>

        <!-- Separator -->
        <Separator orientation="VERTICAL" styleClass="nav-separator" />

        <!-- spacer -->
        <Region HBox.hgrow="ALWAYS" />

        <!-- Right: Profile -->
        <VBox fx:id="profileBox" alignment="CENTER" spacing="6">
            <ImageView fx:id="avatarImage" fitWidth="48" fitHeight="48" preserveRatio="true" styleClass="profile-avatar" />
            <Label fx:id="usernameLabel" text="username" styleClass="profile-username" />
        </VBox>

    </HBox>

    <!-- Content area with page title and three proposal lists -->
    <VBox fx:id="contentArea" styleClass="collector-content" VBox.vgrow="ALWAYS" alignment="TOP_CENTER" spacing="20">
        <padding>
            <Insets top="40" left="40" right="40" bottom="40" />
        </padding>
        <Label text="Manage Proposals" styleClass="page-title" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;" />
        
        <!-- Received Pending Proposals Section -->
        <VBox spacing="10" style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 10; -fx-padding: 20;">
            <Label text="Received Proposals (Pending)" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <ScrollPane fx:id="receivedScrollPane" fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" prefHeight="200">
                <VBox fx:id="receivedProposalsList" spacing="10" style="-fx-background-color: transparent;" />
            </ScrollPane>
        </VBox>
        
        <!-- Sent Proposals Section -->
        <VBox spacing="10" style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 10; -fx-padding: 20;">
            <Label text="Sent Proposals" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <ScrollPane fx:id="sentScrollPane" fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" prefHeight="200">
                <VBox fx:id="sentProposalsList" spacing="10" style="-fx-background-color: transparent;" />
            </ScrollPane>
        </VBox>
        
        <!-- Completed Proposals Section -->
        <VBox spacing="10" style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 10; -fx-padding: 20;">
            <Label text="Completed Proposals" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <ScrollPane fx:id="completedScrollPane" fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" prefHeight="200">
                <VBox fx:id="completedProposalsList" spacing="10" style="-fx-background-color: transparent;" />
            </ScrollPane>
        </VBox>
    </VBox>

</VBox>
